# AgentOnTrack optional settings. Copy this file to e.env (same folder) and fill in only what you want.
#
# NOTHING HERE IS REQUIRED. AgentOnTrack works with an empty or missing e.env.
#
# Your Claude Code, Codex and other agent subscriptions are NOT configured here. Sign in with each agent's own command
# (for example `claude auth login`, `codex login`). AgentOnTrack never reads, copies or stores those sign-ins.
#
# This file is never committed (it is in .gitignore), never uploaded, and AgentOnTrack never prints, logs or exports its values.
# Values are kept in memory by the companion only. They are NOT copied into the environment of any program it starts, except as noted below.
# Do not put quotes around a value unless it contains spaces. Lines starting with # are comments.

# --- Paid API mode (off by default) ---------------------------------------------------------------------------------------
# Leave this unset to stay subscription-first: API-key variables are removed from every agent AgentOnTrack starts, and an agent
# signed in with an API key or cloud account is refused. Set to 1 ONLY if you want agents to bill by use through the keys below.
AOT_ALLOW_PAID_API=

# Each key is given to its own agent, and only when AOT_ALLOW_PAID_API=1. Leave empty to use your subscription.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Local models -------------------------------------------------------------------------------------------------------
# Address of a local Ollama server, if you run one. Default: http://127.0.0.1:11434
OLLAMA_HOST=
